# OOP: fields, ctor, method via vtable, operator+, deterministic dtor (ARC)
import std.io.{println};
class Point {
    Point(x: int, y: int) { self.x = x; self.y = y; }
    func sum() -> int { return self.x + self.y; }
    operator+(o: Point) -> Point { return Point(self.x + o.x, self.y + o.y); }
    ~Point() { println(self.x); }
    let x: int;
    let y: int;
}
func main() -> int {
    let p = Point(3, 4);
    println(p.sum());
    let q = p + Point(1, 1);
    println(q.sum());
    return 0;
}
