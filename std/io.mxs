# MXScript standard I/O — std.io
#
# Two layers (docs/type_system.md §8, docs/ffi.md):
#   1. @@foreign bindings to the runtime polymorphic C-ABI (mxs_*), implemented in core.bc.
#   2. (this module is a thin layer-1 surface — no mxs-level wrappers yet.)
#
# Bound generically via @@foreign — the compiler does NO per-function special-casing. Values are
# real core::MXObject*; the stdio family binds to the polymorphic print/format over
# MXObject::str()/repr(). print/println/format are variadic (progress12 D-VARARG): surplus args
# are packed into an MXArrayList.
#
# Import-gated (progress13 D2): reach these only via `import std.io;` (qualified `io.println(...)`),
# `import std.io as o;`, or `import std.io.{println, print, format, str, repr};` (unqualified).
# Nothing here is in scope without an import.
import std._file;


@@foreign(symbol_name="mxs_println")
func println(...args: any) -> nil;

@@foreign(symbol_name="mxs_print")
func print(...args: any) -> nil;

func input(prompt: str) -> str{}

# if a io buffer exist in crrent implementation
func flush_buffer(){} 
func resize_buffer(){}

func print_error_msg() {}

