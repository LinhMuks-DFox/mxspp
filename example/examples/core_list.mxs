# Power operator, list literals, subscript and len/append on the real object model (run-core).
# Expected: 1024 / [10, 20, 30] / 20 / 3 / [10, 20, 30, 40] / 4
import std.io.{println};

func main() -> int {
    println(2 ** 10);          # 1024
    let xs = [10, 20, 30];
    println(xs);               # [10, 20, 30]
    println(xs[1]);            # 20
    println(xs.len());         # 3
    xs.append(40);
    println(xs);               # [10, 20, 30, 40]
    println(xs.len());         # 4
    return 0;
}
