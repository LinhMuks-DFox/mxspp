# Cross-type dynamic dispatch on the real object model (run-core).
# Expected: hello world / 3.5 / 2.5 / 2 / true / false
import std.io.{println};

func main() -> int {
    println("hello " + "world");   # string concat
    println(1.5 + 2);              # int promotes to float -> 3.5
    println(10.0 / 4);             # 2.5
    println(10 / 4);               # int division -> 2
    println(2 < 3);                # true
    println(3.5 < 2);              # false (numeric compare across types)
    return 0;
}
