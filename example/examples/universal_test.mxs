# =============================================================================
# Universal MxScript Feature Test
#
# A showcase of (almost) every MxScript language feature, rewritten to conform
# to the formal grammar (syntax.ebnf / grammar.hpp) and the design docs.
#
# PART A below parses with the current grammar. PART B (at the bottom, all in
# comments) lists features that are DESIGNED in the docs but not yet expressible
# in the grammar — each annotated with what it would need.
# =============================================================================

# ---- Module system ----------------------------------------------------------
import std.io as io;
import std.error.Error as Error;

# ---- Top-level bindings (static is resolved at compile time) -----------------
static let println = io.println;

# ---- Functions: grouping, defaults, inferred nil return ----------------------
func add(a, b: int) -> int {
    return a + b;
}

# 'width' and 'height' share type int; 'loud' has a default value.
func make_window(title: string, width, height: int, loud: bool = false) -> nil {
    println(title);
}

# No declared return type => implicitly returns nil.
func log(message: string) {
    println(message);
}

# ---- Recursion (correct Fibonacci this time) ---------------------------------
@@static_deterministic
func fib(n: int) -> int {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

# ---- Generics (inline <T> form from the grammar) -----------------------------
func identity<T>(value: T) -> T {
    return value;
}

func first<T, U>(a: T, b: U) -> T {
    return a;
}

# ---- Manual optimization annotation ------------------------------------------
@@manual_optimize_level(level=3)
func hot_path(a, b: int) -> int {
    return a * b + a;
}

# ---- Value-based error handling: union return, raise, '?' propagation --------
func parse_int(s: string) -> int | Error {
    if s == "" {
        return raise Error("ValueError", "empty input", alternative=0);
    }
    return 42;
}

func add_one(s: string) -> int | Error {
    let n = parse_int(s)?;   # '?' returns early if parse_int produced an Error
    return n + 1;
}

# ---- match expression (literal + wildcard patterns) --------------------------
func classify(n: int) -> string {
    return match (n) {
        case 0 => "zero"
        case 1 => "one"
        case _ => "many"
    };
}

# ---- POD type for zero-cost C interop ----------------------------------------
@@POD
class Vec3 {
public:
    let x: float;
    let y: float;
    let z: float;
}

# ---- Classes: fields, constructor, destructor, methods, static, operators ----
class Animal {
public:
    let name: string;
    let mut age: int;

    Animal(name: string, age: int) {
        self.name = name;
        self.age = age;
    }

    ~Animal() {
        println("an animal is gone");
    }

    func speak() -> string {
        return "...";
    }

    func birthday() -> nil {
        self.age = self.age + 1;
    }

    static func kingdom() -> string {
        return "Animalia";
    }

private:
    let mut _tag: int;
}

# ---- Inheritance + base-constructor call + override --------------------------
class Dog : Animal {
public:
    Dog(name: string) : Animal(name, 0) {
        println("a dog is born");
    }

    override func speak() -> string {
        return "Woof";
    }
}

# ---- Operator overloading ----------------------------------------------------
class Vec2 {
public:
    let mut x: int;
    let mut y: int;

    Vec2(x: int, y: int) {
        self.x = x;
        self.y = y;
    }

    operator+(other: Vec2) -> Vec2 {
        return Vec2(self.x + other.x, self.y + other.y);
    }

    operator==(other: Vec2) -> bool {
        return self.x == other.x && self.y == other.y;
    }
}

# ---- Generic class -----------------------------------------------------------
class Box<T> {
public:
    let mut value: T;

    Box(value: T) {
        self.value = value;
    }

    func get() -> T {
        return self.value;
    }
}

# ---- Interface with a default method, and a class implementing it ------------
interface Drawable {
    func draw() -> nil;
    func describe() -> string {
        return "a drawable";
    };
}

class Circle : Drawable {
public:
    let radius: int;

    Circle(radius: int) {
        self.radius = radius;
    }

    override func draw() -> nil {
        println("drawing a circle");
    }
}

# ---- Plain struct type -------------------------------------------------------
type Point {
    x: int;
    y: int;
}

# ---- Enums (plain and data-carrying variants) --------------------------------
enum Direction {
    North,
    East,
    South,
    West
}

enum Shape {
    Dot,
    Circle(radius: int),
    Rectangle(width, height: int)
}

# ---- Control flow: if/else-if/else, for-in, loop, until, do-until, defer ------
func control_demo() -> nil {
    let mut i = 0;

    if i == 0 {
        println("zero");
    } else if i == 1 {
        println("one");
    } else {
        println("many");
    }

    for n in 0..5 {
        println(n);
    }

    loop {
        i = i + 1;
        if i == 2 {
            continue;
        }
        if i >= 5 {
            break;
        }
    }

    let mut j = 0;
    until (j == 5) {        # pre-test: runs while the condition is false
        j = j + 1;
    }

    let mut k = 0;
    do {                    # post-test: runs at least once
        k = k + 1;
    } until (k == 5);

    defer {
        println("scope cleanup runs here");
    }

    assert 1 + 1 == 2;
}

# ---- Lambdas (func signature => expression-or-block) -------------------------
func lambda_demo() -> nil {
    let square = (x: int) -> int => x * x;
    let r = square(9);
    println(r);

    let greet = (name: string) -> nil => {
        println(name);
    };
    greet("world");
}

# ---- Entry point -------------------------------------------------------------
func main() -> int {
    log("starting");

    println(fib(10));
    println(identity<int>(7));
    println(classify(3));

    let v = Vec2(1, 2) + Vec2(3, 4);
    println(v.x);

    let d = Dog("Rex");
    println(d.speak());

    let b = Box<int>(99);
    println(b.get());

    control_demo();
    lambda_demo();

    return 0;
}

# =============================================================================
# PART B — Designed in the docs, but NOT yet expressible in the grammar.
# (Kept as comments so this file still parses. Each line notes the gap.)
# =============================================================================
#
# 1) Container literals & types (docs/type_system.md) — not in `literal`/`type_spec`:
#      let xs: List<int>    = [1, 2, 3];
#      let arr: [3]int      = [10, 20, 30];
#      let scores: Dict<string, int> = ["math": 95, "science": 88];
#      let t: (int, string) = (1, "hi");        # tuple literal + tuple type
#
# 2) Tuple destructuring in `let` (used by generic_swap.mxs) — let binds an
#    identifier_list, not a tuple pattern:
#      let (a, b) = swap<int>(10, 20);
#
# 3) Type-binding `match` patterns (the canonical usage in docs + matrix_class) —
#    `pattern` only supports literal / constructor / wildcard, not `name: Type`:
#      match (result) {
#          case e: Error => { println(e.message); e.alternative; }
#          case n: int   => { n; }
#      }
#
# 4) Bodyless `@@foreign` declarations (docs/ffi.md) — func_def requires a block,
#    and `argv=[...]` needs list literals + `...`:
#      @@foreign(lib="libc.so", symbol_name="write")
#      func c_write(fd: int, buf: string, count: int) -> int;
#      @@foreign(lib="wrappers.so", argv=[1, ...]) func c_printf(fmt: string, ...);
#
# 5) Positional annotation args, e.g. `@@template(T)` (docs/generic_swap.mxs) —
#    annotation args must currently be `key = value`. Inline `func f<T>(...)` works.
#
# 6) `super(...)` base-ctor call in the body (docs §6.3) — the grammar uses the
#    `Ctor(...) : Base(args) { }` form instead.
#
# 7) Multi-line comment block `!##! ... !##!` (basic_syntax.md) — the lexer only
#    implements `#` line comments (and C-style `/* */`).
# =============================================================================
