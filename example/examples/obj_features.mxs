# Object-mode smoke test: variables, loops, strings and mixed-type dynamic dispatch.
# Run with:  mxs run-obj example/examples/obj_features.mxs
# Expected output:
#   hello, world
#   10
#   6
#   3.5
#   true
#   true

func main() -> int {
    let greeting = "hello, " + "world";
    println(greeting);

    let mut sum = 0;
    for i in 1..5 {
        sum = sum + i;          # 1 + 2 + 3 + 4
    }
    println(sum);               # 10

    let mut n = 3;
    let mut acc = 1;
    until (n == 0) {
        acc = acc * n;
        n = n - 1;
    }
    println(acc);               # 6

    println(1.5 + 2);           # 3.5 — int promotes to float at runtime
    println(2 < 3);             # true — comparison yields a boxed bool
    println(!false);            # true — logical not
    return 0;
}
