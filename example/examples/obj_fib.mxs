# Object-mode smoke test: recursion, comparison, arithmetic, and a returned object.
# Run with:  mxs run-obj example/examples/obj_fib.mxs   ->   55

import std.io.{println};

func fib(n: int) -> int {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func main() -> int {
    println(fib(10));
    return 0;
}
